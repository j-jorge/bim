msgid "Please wait"
msgstr "Будь ласка, зачекайте"

msgid "You have been disconnected :("
msgstr "Стався розрив з'єднання :("

msgid ""
"The shop is not available on this platform, yet you can support the "
"developers with donations! Should I open the donations page?"
msgstr ""
"Магазин не доступний на цій платформі, ви можете підтримати розробників "
"фінансово! Чи варто мені відкрити сторінку зборів?"

msgid "Do you really want to change the language setting?"
msgstr "Ви справді хочете змінити налаштування мови?"

#, c++-format
msgid "Version {}"
msgstr "Версія {}"

msgid "Feedback about Bim!"
msgstr "Відгук про Bim!"

#, c++-format
msgid "Come play a game of Bim! {}"
msgstr "Нумо грати в Bim! {}"

msgid "You need more coins to purchase this item!"
msgstr "Вам потрібно більше монет, щоб придбати цей предмет!"

#, c++-format
msgid "Customize your games with up to {} feature."
msgid_plural "Customize your games with up to {} features."
msgstr[0] "Кастомізуй свої гри {} фічою."
msgstr[1] "Кастомізуй свої гри {} фічами."
msgstr[2] "Кастомізуй свої гри {} фічами."

msgid "Falling blocks reduce the arena after two minutes!"
msgstr "Падаючі блоки зменшують поле після другої хвилини!"

msgid "Fences block the players, but the flames can go through!"
msgstr "Паркани розділяють гравців, а через полум'я можна пройти!"

msgid "A thick fog covers the arena. You can't see were you did not go!"
msgstr "Густий туман накрив арену. Ти не бачиш області де ще не був!"

msgid ""
"Find the invisibility power up to disappear from the screen of all other "
"players!"
msgstr "Знайди бонус невидимості, щоб зникнути з екранів інших гравці!"

msgid "Find this incredibly strong barrel, it will save you from one hit!"
msgstr "Знайди неймовірно міцну бочку, вона захистить тебе при ударі!"

#, c++-format
msgid "{} game being played right now."
msgid_plural "{} games being played right now."
msgstr[0] "{} гра проходить зараз."
msgstr[1] "{} гри проходять зараз."
msgstr[2] "{} ігор проходять зараз."

#, c++-format
msgid "{} player connected right now."
msgid_plural "{} players connected right now."
