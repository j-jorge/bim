{
  "enable-contest-timeline-recording": true,
  "contest-timeline-folder": "/opt/bim/persistent/contest/",

  "game-service-max-duration-for-short-game": 30,

  "enable-geolocation": true,
  "geolocation-clean-up-interval": 86400,
  "geolocation-update-interval": 1080,
  "geolocation-database-path": "/opt/bim/persistent/GeoLite2-Country.mmdb",

  "enable-statistics-log": true,
  "enable-rolling-statistics": true,
  "statistics-log-file": "/opt/bim/persistent/log/statistics.txt",

  "enable-karma": true
}
